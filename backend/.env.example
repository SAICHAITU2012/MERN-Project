# ── Server ─────────────────────────────────────────────
PORT=8080

# ── MongoDB ────────────────────────────────────────────
# Local instance:
#   mongodb://localhost:27017/shopkart
# MongoDB Atlas (whitelist your IP under Network Access first):
#   mongodb+srv://<username>:<password>@<cluster-hostname>/shopkart?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/shopkart

# ── Auth ───────────────────────────────────────────────
# Any long random string; sign JWTs stored in httpOnly cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Razorpay (test mode) ───────────────────────────────
# Dashboard → Settings → API Keys → Generate Test Key.
# Leave the REPLACE placeholders in place to run the app without payments
# (checkout will report that keys are not configured).
RAZORPAY_KEY_ID=REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
